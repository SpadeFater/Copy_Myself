# Repository allowlist
/*

# Required project metadata and entry points
!/.editorconfig
!/.env.example
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/CONTRIBUTING.md
!/README.md
!/pyproject.toml
!/app_logging.py
!/cli.py
!/config.py

# Application modules
!/agent/
!/agent/**
!/api/
!/api/**
!/builtin_mcp/
!/builtin_mcp/**
!/domain/
!/domain/**
!/gui/
!/gui/**
!/llm/
!/llm/**
!/memory/
!/memory/**
!/mcp_gateway/
!/mcp_gateway/**

# Python caches and build outputs
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local environments and secrets
.env
.env.*
!.env.example
.venv/
venv/
env/
keys

# Runtime data
memoryGraphData/
**/memoryGraphData/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.db
*.db-shm
*.db-wal

# Non-shipping workspaces
docs/
tests/

# IDE and OS state
.idea/
.vscode/
.DS_Store
Thumbs.db

# Retired or accidental frontend artifacts
node_modules/
frontend/dist/
frontend/build/
web/dist/
web/build/
